    "eslint-plugin-react-refresh": "^0.4.16",
    "framer-motion": "^11.0.19",
    "next": "15.5.21",
    "react": "^18",
    "react-dom": "^18",
    "sass": "^1.69.5",
    "semantic-ui-css": "^2.5.0",
